*.har
secrets/
.env
.env.*
!.env.template

# Probe-Ausgaben (personenbezogen)
probe-output/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Lokale Daten (DB, raw) nie committen
/data/

